{
  "name": "transit-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "City transit map — thousands of stops, clustering and 15-minute isochrones",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
